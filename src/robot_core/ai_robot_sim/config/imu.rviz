Panels:
  - Class: rviz_common/Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: Robot Model
      Enabled: true
      Description Topic:
        Value: /robot/robot_description
    - Class: rviz_default_plugins/Axes
      Name: IMU Frame
      Enabled: true
      Reference Frame: imu_link
      Length: 0.2
      Radius: 0.01
  Global Options:
    Fixed Frame: base_link
    Background Color: 48; 48; 48
  Name: root
Window Geometry:
  Height: 800
  Width: 1200
