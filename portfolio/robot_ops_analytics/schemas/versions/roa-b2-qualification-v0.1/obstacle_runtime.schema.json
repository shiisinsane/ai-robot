{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roa-b2-obstacle-runtime-v0.1",
  "title": "W7 B2单项运行时障碍配置Schema",
  "type": "object",
  "required": ["version", "source_task_id", "obstacle_profiles"],
  "properties": {
    "version": {"const": "roa-w7-b2-pilot-obstacle-runtime-v0.1"},
    "source_task_id": {"type": "string"},
    "obstacle_profiles": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "environment_ready", "qualification_ready", "world", "model",
                     "x_m", "y_m", "z_m", "route_id"],
        "properties": {
          "id": {"enum": ["none", "low", "medium"]},
          "environment_ready": {"const": false}, "qualification_ready": {"const": true},
          "world": {"const": "m5_slam"}, "model": {"const": "temporary_obstacle"},
          "x_m": {"type": "number"}, "y_m": {"type": "number"},
          "z_m": {"type": "number"}, "route_id": {"type": "string"}
        }
      }
    }
  }
}
