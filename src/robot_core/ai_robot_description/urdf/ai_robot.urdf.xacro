<?xml version="1.0"?>
<robot name="ai_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="model_config" default="$(find ai_robot_description)/config/robot_model.yaml"/>
  <xacro:arg name="sensor_config" default="$(find ai_robot_description)/config/sensor_model.yaml"/>
  <xacro:arg name="enable_control" default="false"/>
  <xacro:arg name="enable_lidar" default="false"/>
  <xacro:arg name="enable_camera" default="false"/>
  <xacro:arg name="enable_imu" default="false"/>
  <xacro:arg name="controller_config" default=""/>
  <xacro:property name="model_config_path" value="$(arg model_config)"/>
  <xacro:property name="sensor_config_path" value="$(arg sensor_config)"/>
  <xacro:property name="model" value="${xacro.load_yaml(model_config_path)}"/>
  <xacro:property name="sensors" value="${xacro.load_yaml(sensor_config_path)}"/>

  <xacro:include filename="macros/inertial.xacro"/>
  <xacro:include filename="macros/base.xacro"/>
  <xacro:include filename="macros/running_gear.xacro"/>
  <xacro:include filename="macros/control.xacro"/>
  <xacro:include filename="macros/sensors.xacro"/>

  <xacro:base_structure model="${model}"/>
  <xacro:drive_wheel
    side="left"
    wheel="${model['drive']['wheels']['left']}"
    drive="${model['drive']}"
  />
  <xacro:drive_wheel
    side="right"
    wheel="${model['drive']['wheels']['right']}"
    drive="${model['drive']}"
  />
  <xacro:support_ball item="${model['casters']['items'][0]}" casters="${model['casters']}"/>
  <xacro:support_ball item="${model['casters']['items'][1]}" casters="${model['casters']}"/>

  <xacro:if value="$(arg enable_lidar)">
    <xacro:lidar_sensor lidar="${sensors['lidar']}"/>
  </xacro:if>
  <xacro:if value="$(arg enable_camera)">
    <xacro:camera_sensor camera="${sensors['camera']}"/>
  </xacro:if>
  <xacro:if value="$(arg enable_imu)">
    <xacro:imu_sensor imu="${sensors['imu']}"/>
  </xacro:if>

  <xacro:if value="$(arg enable_control)">
    <xacro:gazebo_control controller_config="$(arg controller_config)"/>
  </xacro:if>
</robot>
