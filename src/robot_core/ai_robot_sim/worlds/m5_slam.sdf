<?xml version="1.0"?>
<sdf version="1.8">
  <world name="m5_slam">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu"/>
    <gravity>0 0 -9.80665</gravity>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.65 0.65 0.65 1</background></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></visual>
    </link></model>
    <model name="north_wall"><static>true</static><pose>0 3 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>6.5 0.15 1</size></box></geometry></collision><visual name="v"><geometry><box><size>6.5 0.15 1</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -3 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>6.5 0.15 1</size></box></geometry></collision><visual name="v"><geometry><box><size>6.5 0.15 1</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>3.25 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 6 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 6 1</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-3.25 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 6 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 6 1</size></box></geometry></visual></link></model>
    <model name="landmark_a"><static>true</static><pose>1.7 1.4 0.5 0 0 0.2</pose><link name="link"><collision name="c"><geometry><box><size>0.6 0.4 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.6 0.4 1</size></box></geometry></visual></link></model>
    <model name="landmark_b"><static>true</static><pose>-1.6 -1.2 0.5 0 0 -0.4</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry></visual></link></model>
  </world>
</sdf>
